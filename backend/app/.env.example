# 安全密钥配置
# 生产环境必须设置新的密钥！
# 生成新密钥命令: openssl rand -hex 64
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# 环境配置
NODE_ENV=production

# 日志级别（可选，默认 info）
LOG_LEVEL=info

# CORS配置 - 多个域名用逗号分隔
# 生产环境请设置您的实际域名
CORS_ORIGIN=https://yourdomain.com

# Cookie安全设置
# 生产环境必须设置为true (需要HTTPS)
SECURE_COOKIE=true

# Cookie 域（可选，跨子域共享 session 时设置，如 .yourdomain.com）
COOKIE_DOMAIN=

# 可信反代的地址或网段（可选，逗号分隔）：部署在反代后时填，反代在 Docker 网络或本机上就填 loopback,uniquelocal。
# 不能填数字跳数，启动会报错。直连暴露端口时留空（按真实连接 IP 限流，避免伪造 X-Forwarded-For 绕过）
TRUST_PROXY=

# 管理员账户配置
# 首次部署时设置管理员账户
ADMIN_USERNAME=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-password-here

# 数据库配置
DATABASE_URL=mysql://user:password@localhost:3306/database
DB_CONNECTION_LIMIT=10

# 全局速率限制（可选）：按客户端 IP 计数。
# 同一门店多台设备走同一出口 IP 时共享额度，人多需调大。
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# 微信公众号推送
# 使用 Cloudflare Workers 部署 wxpush
# 部署教程：https://github.com/frankiejun/wxpush
WXPUSH_URL=https://your-worker.workers.dev/wxsend
WXPUSH_TOKEN=your-api-token

# 会员消费短信：disabled / mock / tencent
# mock 只生成演示记录，不会向真实手机发送。
SMS_ENABLED=false
SMS_PROVIDER=disabled
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# --- P0 缺口补齐（依赖待决 Q-10 / Q-12，当前采用建议默认值，待经营者确认后可调整）---
# 仅登记键名与占位说明，请勿在此写入任何真实密码 / 密钥值。
# 演示四级账号：MANAGER / STYLIST / ASSISTANT 共用同一演示密码；
# 未设置 DEMO_STAFF_PASSWORD 时回退使用上面的 ADMIN_PASSWORD（即四级同密码）。
# 账号名有固定默认值，仅在需要覆盖时设置下面三个键。
DEMO_STAFF_PASSWORD=
MANAGER_USERNAME=
STYLIST_USERNAME=
ASSISTANT_USERNAME=

# 消费短信回执回调「预留端点」开关：默认关闭（false）。
# 本轮不接腾讯云、不写真实密钥、不产生真实下发；仅本地验收需要注入模拟回执时临时设为 true，
# 启用后仍需 ADMIN / MANAGER 鉴权（STYLIST / ASSISTANT 返回 403）。
SMS_RECEIPT_CALLBACK_ENABLED=false
