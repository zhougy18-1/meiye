generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Member {
  id               String        @id
  externalId       String?       @unique @db.VarChar(64)
  classification   String?       @db.VarChar(100)
  phone            String?
  name             String
  gender           Gender?       @default(UNKNOWN)
  birthday         DateTime?
  registrationDate DateTime?
  historicalRecharge Decimal?    @db.Decimal(12, 2)
  historicalConsumption Decimal? @db.Decimal(12, 2)
  openingBalanceNotes String?     @db.Text
  importBatchId    String?
  status           MemberStatus  @default(ACTIVE)
  notes            String?       @db.Text
  smsNotificationEnabled Boolean @default(false)
  appointments     Appointment[]
  cards            Card[]
  transactions     Transaction[]
  packageHoldings  PackageHolding[]
  smsNotifications SmsNotification[]
  importBatch      MemberMigrationBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([phone])
  @@index([status])
  @@index([registrationDate])
  @@index([birthday])
  @@index([classification])
  @@index([importBatchId])
}

model Card {
  id                 String        @id
  memberId           String
  cardTypeId         String
  balance            Decimal       @default(0.00) @db.Decimal(10, 2)
  issueDate          DateTime      @default(now())
  expiryDate         DateTime?
  status             CardStatus    @default(ACTIVE)
  customAmount       Decimal?      @db.Decimal(10, 2)
  customDiscountRate Decimal?      @db.Decimal(4, 3)
  discountSource     String        @default("card_type")
  isCustomCard       Boolean       @default(false)
  openingBalance     Decimal?      @db.Decimal(10, 2)
  importBatchId      String?
  cardType           CardType      @relation(fields: [cardTypeId], references: [id])
  member             Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  transactionLinks   TransactionCardLink[]
  importBatch        MemberMigrationBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  @@index([cardTypeId])
  @@index([status])
  @@index([issueDate])
  @@index([memberId, status])
  @@index([importBatchId])
}

model CardType {
  id           String        @id
  name         String        @unique
  initialPrice Decimal       @db.Decimal(10, 2)
  discountRate Decimal       @db.Decimal(4, 3)
  status       ServiceStatus @default(AVAILABLE)
  cards        Card[]

  @@index([status])
}

model Service {
  id              String            @id
  name            String            @unique
  standardPrice   Decimal           @db.Decimal(10, 2)
  status          ServiceStatus     @default(AVAILABLE)
  sortOrder       Int               @default(99)
  noDiscount      Boolean           @default(false)
  TransactionItem TransactionItem[]
  appointments    Appointment[]     @relation("AppointmentToService")
  packagePlans    PackagePlan[]

  @@index([status])
  @@index([sortOrder])
  @@index([noDiscount])
}

model Transaction {
  id               String            @id
  memberId         String?
  staffId          String?
  summary          String?           @db.Text
  totalAmount      Decimal           @db.Decimal(10, 2)
  actualPaidAmount Decimal           @db.Decimal(10, 2)
  discountAmount   Decimal           @db.Decimal(10, 2)
  paymentMethod    PaymentMethod
  cardId           String?
  transactionTime  DateTime          @default(now())
  notes            String?           @db.Text
  customerName     String?
  isPending        Boolean           @default(false)
  transactionType  TransactionType   @default(NORMAL)
  balanceSnapshot  Json?             // 记录交易前后的卡余额快照，格式: { totalBalanceBefore, totalBalanceAfter, cards: [{ cardId, cardName, balanceBefore, balanceAfter, isUsed }] }
  appointment      Appointment?
  cardUsed         Card?             @relation(fields: [cardId], references: [id])
  member           Member?           @relation(fields: [memberId], references: [id])
  staff            Staff?            @relation(fields: [staffId], references: [id])
  items            TransactionItem[]
  cardLinks        TransactionCardLink[]
  smsNotification  SmsNotification?

  @@index([transactionTime])
  @@index([memberId])
  @@index([staffId])
  @@index([paymentMethod])
  @@index([cardId])
  @@index([transactionTime, memberId])
  @@index([transactionTime, paymentMethod])
  @@index([transactionType])
  @@index([isPending])
  @@index([memberId, isPending])
}

// 消费短信发送台账。不保存完整手机号，重试时从会员资料读取当前号码。
model SmsNotification {
  id                String      @id @default(cuid())
  transactionId     String      @unique
  memberId          String?
  phoneLast4        String      @db.VarChar(4)
  status            String      @default("PENDING") @db.VarChar(16)
  provider          String      @db.VarChar(32)
  amount            Decimal     @db.Decimal(10, 2)
  balanceAfter      Decimal     @db.Decimal(10, 2)
  occurredAt        DateTime
  messagePreview    String      @db.VarChar(500)
  templateParams    Json
  providerRequestId String?     @db.VarChar(191)
  providerCode      String?     @db.VarChar(191)
  errorMessage      String?     @db.VarChar(500)
  // P0 缺口补齐：回执期字段（依赖待决 Q-09/Q-12），全部可空，旧台账零破坏。
  // 与 providerRequestId / providerCode / errorMessage（发送期）语义分离。
  receiptAt         DateTime?
  terminalStatus    String?     @db.VarChar(16)
  rejectCode        String?     @db.VarChar(191)
  rejectReason      String?     @db.VarChar(500)
  receiptRequestId  String?     @db.VarChar(191)
  attemptCount      Int         @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  member            Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([memberId, createdAt])
  @@index([createdAt])
}

model TransactionCardLink {
  id            String      @id @default(cuid())
  transactionId String
  cardId        String
  cardName      String
  amount        Decimal     @db.Decimal(10, 2)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  card          Card        @relation(fields: [cardId], references: [id])

  @@index([transactionId])
  @@index([cardId])
}

model TransactionItem {
  id            String      @id
  transactionId String
  serviceId     String
  price         Decimal     @db.Decimal(10, 2)
  quantity      Int         @default(1)
  service       Service     @relation(fields: [serviceId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([serviceId])
}

model Staff {
  id               String        @id
  name             String
  position         String
  phone            String?       @unique
  hireDate         DateTime      @default(now())
  status           StaffStatus   @default(ACTIVE)
  countsCommission Boolean       @default(true)
  sortOrder        Int           @default(99)
  appointments     Appointment[]
  transactions     Transaction[]
  user             User?

  @@index([status])
  @@index([hireDate])
  @@index([countsCommission])
  @@index([sortOrder])
}

model Appointment {
  id              String            @id
  memberId        String?
  customerName    String
  customerPhone   String
  appointmentTime DateTime
  assignedStaffId String?
  status          AppointmentStatus @default(PENDING)
  notes           String?
  transactionId   String?           @unique
  // P0 缺口补齐：预约线索三字段（依赖待决 Q-05/Q-06/Q-07），全部可空，旧记录显示「未标注」。
  customerType    String?           @db.VarChar(16)
  sourceChannel   String?           @db.VarChar(32)
  bedId           String?           @db.VarChar(16)
  staff           Staff?            @relation(fields: [assignedStaffId], references: [id])
  member          Member?           @relation(fields: [memberId], references: [id])
  transaction     Transaction?      @relation(fields: [transactionId], references: [id])
  services        Service[]         @relation("AppointmentToService")

  @@index([appointmentTime])
  @@index([status])
  @@index([memberId])
  @@index([assignedStaffId])
  @@index([customerPhone])
  @@index([appointmentTime, status])
  @@index([appointmentTime, assignedStaffId])
  // 支撑「同床位同时段不可重复占用」查询。
  @@index([appointmentTime, bedId])
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  password      String
  role          Role           @default(STYLIST)
  createdAt     DateTime       @default(now())
  staffId       String?        @unique
  refreshTokens RefreshToken[]
  staff         Staff?         @relation(fields: [staffId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  // 滑动续期需要知道原始时长（信任设备 7 天 / 否则 1 天），无法从 expiresAt 反推
  validityDays Int   @default(1)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemConfig {
  id                    Int       @id @default(1)
  enableLoginCaptcha    Boolean   @default(true)
  enableTransactionVoid Boolean   @default(false)
  voidEnabledAt         DateTime?
  bookingCode           String?   @db.VarChar(32)
  bookingCodeUpdatedAt  DateTime?
}

model VoidLog {
  id               String   @id @default(cuid())
  originalTxId     String
  originalTxTime   DateTime
  memberId         String?
  memberName       String?
  summary          String?
  totalAmount      Decimal  @db.Decimal(10, 2)
  actualPaidAmount Decimal  @db.Decimal(10, 2)
  paymentMethod    String
  cardInfo         String?  @db.Text
  balanceRestored  String?  @db.Text
  balanceSnapshot  Json?    // 原始交易的余额快照，格式与 Transaction.balanceSnapshot 一致
  voidedAt         DateTime @default(now())
  voidedBy         String
  voidedByName     String
  reason           String?

  @@index([voidedAt])
  @@index([memberId])
  @@index([voidedBy])
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum CardStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  FROZEN
}

enum ServiceStatus {
  AVAILABLE
  UNAVAILABLE
}

enum PaymentMethod {
  CASH
  WECHAT_PAY
  ALIPAY
  DOUYIN
  MEITUAN
  CARD_SWIPE
  MEMBER_CARD
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TransactionType {
  NORMAL
  PENDING
  PENDING_CLEAR
  CARD_PURCHASE
}

enum Role {
  ADMIN
  MANAGER
  STYLIST
  ASSISTANT
}

// M.77 演示：独立的次卡台账。收款不写入旧 Transaction，避免旧撤销逻辑破坏履约余额。
model PackagePlan {
  id        String           @id @default(cuid())
  name      String
  serviceId String
  totalUses Int
  price     Decimal          @db.Decimal(10, 2)
  validDays Int?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  createdBy String
  service   Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  holdings  PackageHolding[]

  @@index([serviceId, active])
}

model PackageHolding {
  id            String         @id @default(cuid())
  memberId      String
  planId        String
  // 保存购买时的名称和次数，后续模板变更不影响已经售出的权益。
  planName      String
  totalUses     Int
  remainingUses Int
  paidAmount    Decimal        @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  status        String         @default("ACTIVE") @db.VarChar(16)
  purchasedAt   DateTime       @default(now())
  expiresAt     DateTime?
  createdBy     String
  createdByName String
  requestKey    String         @unique @db.VarChar(128)
  source        String         @default("SALE") @db.VarChar(16)
  importBatchId String?
  openingRemainingUses Int?
  openingPurchasedUses Int?
  openingUsedUses Int?
  openingNotes String? @db.Text
  member        Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan          PackagePlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  usages        PackageUsage[]
  // P0 缺口补齐：退款/作废审计留痕（只增关系，不删除持有记录）。
  audits        PackageRefundAudit[]
  importBatch   MemberMigrationBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  @@index([memberId, purchasedAt])
  @@index([planId])
  @@index([status, expiresAt])
  @@index([source])
  @@index([importBatchId])
}

model MemberMigrationBatch {
  id                String   @id @default(cuid())
  fileName          String   @db.VarChar(255)
  fileHash          String   @db.VarChar(64)
  cutoffAt          DateTime
  status            String   @default("PREVIEW") @db.VarChar(24)
  snapshot          Json
  mappings          Json
  issues            Json
  previewSummary    Json
  resultSummary     Json?
  acknowledgements  Json?
  createdBy         String
  createdByName     String
  createdAt         DateTime @default(now())
  committedAt       DateTime?
  rolledBackAt      DateTime?
  rolledBackBy      String?
  rolledBackByName  String?
  rollbackReason    String?  @db.VarChar(500)
  members           Member[]
  cards             Card[]
  holdings          PackageHolding[]

  @@index([fileHash, status])
  @@index([status, createdAt])
}

model PackageUsage {
  id             String         @id @default(cuid())
  holdingId      String
  requestKey     String         @unique @db.VarChar(128)
  usedAt         DateTime       @default(now())
  usedBy         String
  usedByName     String
  note           String?        @db.VarChar(500)
  reversedAt     DateTime?
  reversedBy     String?
  reversedByName String?
  reverseReason  String?        @db.VarChar(500)
  holding        PackageHolding @relation(fields: [holdingId], references: [id], onDelete: Restrict)

  @@index([holdingId, usedAt])
}

// P0 缺口补齐：独立套餐退款/作废审计台账（依赖待决 Q-01/Q-02/Q-03/Q-04）。
// 不写旧 Transaction、不删除 PackageHolding / PackageUsage；购买快照留在 PackageHolding 上不冗余复制。
model PackageRefundAudit {
  id                   String          @id @default(cuid())
  holdingId            String
  action               String          @db.VarChar(16)
  refundAmount         Decimal         @db.Decimal(10, 2)
  remainingUsesBefore  Int
  remainingUsesAfter   Int
  prevStatus           String          @db.VarChar(16)
  reason               String          @db.VarChar(500)
  approvedBy           String          @db.VarChar(191)
  operatorId           String
  operatorName         String
  occurredAt           DateTime        @default(now())
  requestKey           String          @unique @db.VarChar(128)
  holding              PackageHolding  @relation(fields: [holdingId], references: [id], onDelete: Restrict)

  @@index([holdingId, occurredAt])
  @@index([occurredAt])
  @@index([action])
}
